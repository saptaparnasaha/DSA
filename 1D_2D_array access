#include <stdio.h>
int main()
{
  int arr1D [4] = {10, 20, 30, 40};
  int arr2D [2][3] = {
    {1, 2, 3},
    {4, 5, 6}
  };

  printf ("... Accessing Single elements---\n");
  printf ("1D Array element at index 2: %d\n", arr1D[2]);
  printf ("2D Array elements at row 1, col 2: %d \n\n", arr2D[1][2]);

  printf ("-- 1D Array Transversal (using for loop)--\n");
  for (int i = 0; i < 4; i++)
  {
    printf ("%d ", arr1D[i]);
  }
  printf ("\n\n");
  printf ("-- 2D Array Transversal (using while loop) ---\n");
  int row = 0;
  while (row < 2)
  {
    int col = 0;
    while (col < 3)
    {
      printf ("%d ", arr2D[row][col]);
      col++;
    }
    printf ("\n");
    row++;
  }
  return 0;
}